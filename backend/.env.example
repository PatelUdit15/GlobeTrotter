# ── Database ─────────────────────────────────────────────────────────────────
DB_HOST=localhost
DB_PORT=5432
DB_NAME=globetrotter
DB_USER=postgres
DB_PASSWORD=odooldce

# ── JWT ───────────────────────────────────────────────────────────────────────
JWT_SECRET=globetrotter-super-secret-key-change-in-production
JWT_EXPIRES_IN=30m
REFRESH_TOKEN_SECRET=globetrotter-refresh-secret-key-change-in-production
REFRESH_TOKEN_EXPIRES_IN=7d

# ── Server ────────────────────────────────────────────────────────────────────
PORT=5000
NODE_ENV=development

# ── CORS ─────────────────────────────────────────────────────────────────────
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# ── Uploads ──────────────────────────────────────────────────────────────────
UPLOAD_DIR=uploads
MAX_FILE_SIZE_MB=10
